#!/usr/bin/env bash
# Fake flatpak for tests. Installed version of io.github.o.Demo in $FAKE_DIR/installed
# (absent = not installed). $FAKE_DIR/extra_apps: more `flatpak list` lines (tab-separated).
# $FAKE_DIR/slow: install prints progress for that many seconds.
echo "flatpak $*" >> "$FAKE_DIR/calls"
case "$1" in
  --version) echo "Flatpak 1.16.0";;
  list)
    if [[ "$*" == *--user* ]]; then
      [[ -f "$FAKE_DIR/installed" ]] && printf 'io.github.o.Demo\tDemo\t%s\tdemo-origin\n' "$(cat "$FAKE_DIR/installed")"
      [[ -f "$FAKE_DIR/extra_apps" ]] && cat "$FAKE_DIR/extra_apps"
    fi; true;;
  info) [[ "$*" == *--user* && -f "$FAKE_DIR/installed" ]] || { echo "error: not installed" >&2; exit 1; }
        printf '\nDemo\n\n     ID: io.github.o.Demo\n Version: %s\n' "$(cat "$FAKE_DIR/installed")";;
  install)
    f="${@: -1}"; [[ -f "$f" ]] || { echo "error: no file" >&2; exit 1; }
    # Like real flatpak: a system-wide bundle install needs polkit, which --noninteractive forbids.
    if [[ "$*" == *--system* && ( "$*" == *--noninteractive* || -f "$FAKE_DIR/deny" ) ]]; then
      echo "Installing app/io.github.o.Demo/x86_64/master"
      echo "Error: Failed to install bundle io.github.o.Demo: Flatpak system operation InstallBundle not allowed for user" >&2
      exit 1
    fi
    echo "Required runtime for io.github.o.Demo/x86_64/master (runtime/org.gnome.Platform/x86_64/49) found in remote flathub"
    n=$(cat "$FAKE_DIR/slow" 2>/dev/null || echo 0)
    for ((i=1; i<=n*2; i++)); do printf 'Installing 1/2… %d%%\r' $((i*50/n)); sleep 0.5; done
    echo
    # Fake bundles from the fake gh hold their tag; anything else installs the stable tag.
    if grep -q '^v' "$f"; then sed 's/^v//' "$f"; else sed 's/^v//' "$FAKE_DIR/tag"; fi > "$FAKE_DIR/installed"
    echo "Installing app/io.github.o.Demo/x86_64/master";;
  run) ;;
esac
